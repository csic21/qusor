(module
  (import "qusor" "call" (func $call (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 1 2)
  (data (i32.const 0) "@INVOCATION@")
  (data (i32.const 256) "@DRAFT_MARKER@")
  (data (i32.const 384) "@PROTOCOL_MARKER@")
  (data (i32.const 512) "@PREFIX1@")
  (data (i32.const 768) "@PREFIX2@")
  (func $same (param $a i32) (param $b i32) (param $n i32) (result i32)
    (local $i i32)
    (loop $next
      (if (i32.ge_u (local.get $i) (local.get $n)) (then (return (i32.const 1))))
      (if (i32.ne (i32.load8_u (i32.add (local.get $a) (local.get $i))) (i32.load8_u (i32.add (local.get $b) (local.get $i)))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next))
    unreachable)
  (func $find (param $start i32) (param $length i32) (param $needle i32) (param $size i32) (result i32)
    (local $i i32)
    (loop $next
      (if (i32.gt_u (i32.add (local.get $i) (local.get $size)) (local.get $length)) (then (return (i32.const -1))))
      (if (call $same (i32.add (local.get $start) (local.get $i)) (local.get $needle) (local.get $size)) (then (return (i32.add (local.get $start) (local.get $i)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $next)) unreachable)
  (func $hex (param $c i32) (result i32)
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 48)) (i32.le_u (local.get $c) (i32.const 57))) (then (return (i32.sub (local.get $c) (i32.const 48)))))
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 97)) (i32.le_u (local.get $c) (i32.const 102))) (then (return (i32.sub (local.get $c) (i32.const 87)))))
    (if (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 70))) (then (return (i32.sub (local.get $c) (i32.const 55))))) unreachable)
  (func $u16 (param $p i32) (result i32)
    (i32.or (i32.or (i32.shl (call $hex (i32.load8_u (local.get $p))) (i32.const 12)) (i32.shl (call $hex (i32.load8_u (i32.add (local.get $p) (i32.const 1)))) (i32.const 8)))
      (i32.or (i32.shl (call $hex (i32.load8_u (i32.add (local.get $p) (i32.const 2)))) (i32.const 4)) (call $hex (i32.load8_u (i32.add (local.get $p) (i32.const 3)))))))
  (func $put (param $p i32) (param $c i32) (result i32)
    (if (i32.ge_u (local.get $p) (i32.const 20479)) (then unreachable))
    (i32.store8 (local.get $p) (local.get $c)) (i32.add (local.get $p) (i32.const 1)))
  (func $utf8 (param $p i32) (param $cp i32) (result i32)
    (if (i32.lt_u (local.get $cp) (i32.const 128)) (then (return (call $put (local.get $p) (local.get $cp)))))
    (if (i32.lt_u (local.get $cp) (i32.const 2048)) (then
      (local.set $p (call $put (local.get $p) (i32.or (i32.const 192) (i32.shr_u (local.get $cp) (i32.const 6)))))
      (return (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63)))))))
    (if (i32.lt_u (local.get $cp) (i32.const 65536)) (then
      (if (i32.and (i32.ge_u (local.get $cp) (i32.const 55296)) (i32.le_u (local.get $cp) (i32.const 57343))) (then unreachable))
      (local.set $p (call $put (local.get $p) (i32.or (i32.const 224) (i32.shr_u (local.get $cp) (i32.const 12)))))
      (local.set $p (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63)))))
      (return (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63)))))))
    (if (i32.gt_u (local.get $cp) (i32.const 1114111)) (then unreachable))
    (local.set $p (call $put (local.get $p) (i32.or (i32.const 240) (i32.shr_u (local.get $cp) (i32.const 18)))))
    (local.set $p (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 12)) (i32.const 63)))))
    (local.set $p (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (i32.shr_u (local.get $cp) (i32.const 6)) (i32.const 63)))))
    (call $put (local.get $p) (i32.or (i32.const 128) (i32.and (local.get $cp) (i32.const 63)))))
  (func $decode (param $p i32) (param $end i32) (param $out i32) (result i32)
    (local $c i32) (local $cp i32) (local $low i32)
    (loop $next
      (if (i32.ge_u (local.get $p) (local.get $end)) (then unreachable))
      (local.set $c (i32.load8_u (local.get $p))) (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (if (i32.lt_u (local.get $c) (i32.const 32)) (then unreachable))
      (if (i32.eq (local.get $c) (i32.const 34)) (then (return (local.get $out))))
      (if (i32.eq (local.get $c) (i32.const 92)) (then
        (if (i32.ge_u (local.get $p) (local.get $end)) (then unreachable))
        (local.set $c (i32.load8_u (local.get $p))) (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (if (i32.eq (local.get $c) (i32.const 117)) (then
          (if (i32.gt_u (i32.add (local.get $p) (i32.const 4)) (local.get $end)) (then unreachable))
          (local.set $cp (call $u16 (local.get $p))) (local.set $p (i32.add (local.get $p) (i32.const 4)))
          (if (i32.and (i32.ge_u (local.get $cp) (i32.const 55296)) (i32.le_u (local.get $cp) (i32.const 56319))) (then
            (if (i32.gt_u (i32.add (local.get $p) (i32.const 6)) (local.get $end)) (then unreachable))
            (if (i32.or (i32.ne (i32.load8_u (local.get $p)) (i32.const 92)) (i32.ne (i32.load8_u (i32.add (local.get $p) (i32.const 1))) (i32.const 117))) (then unreachable))
            (local.set $low (call $u16 (i32.add (local.get $p) (i32.const 2))))
            (if (i32.or (i32.lt_u (local.get $low) (i32.const 56320)) (i32.gt_u (local.get $low) (i32.const 57343))) (then unreachable))
            (local.set $cp (i32.add (i32.const 65536) (i32.add (i32.shl (i32.sub (local.get $cp) (i32.const 55296)) (i32.const 10)) (i32.sub (local.get $low) (i32.const 56320)))))
            (local.set $p (i32.add (local.get $p) (i32.const 6)))))
          (local.set $out (call $utf8 (local.get $out) (local.get $cp))) (br $next)))
        (if (i32.eq (local.get $c) (i32.const 110)) (then (local.set $c (i32.const 10)))
        (else (if (i32.eq (local.get $c) (i32.const 114)) (then (local.set $c (i32.const 13)))
        (else (if (i32.eq (local.get $c) (i32.const 116)) (then (local.set $c (i32.const 9)))
        (else (if (i32.eq (local.get $c) (i32.const 98)) (then (local.set $c (i32.const 8)))
        (else (if (i32.eq (local.get $c) (i32.const 102)) (then (local.set $c (i32.const 12)))
        (else (if (i32.and (i32.and (i32.ne (local.get $c) (i32.const 34)) (i32.ne (local.get $c) (i32.const 92))) (i32.ne (local.get $c) (i32.const 47))) (then unreachable))))))))))))
      ))
      (local.set $out (call $put (local.get $out) (local.get $c))) (br $next)) unreachable)
  (func (export "run") (result i32 i32)
    (local $n i32) (local $draft i32) (local $proto i32) (local $p i32) (local $out i32)
    (local.set $n (call $call (i32.const 0) (i32.const @INVOCATION_LEN@) (i32.const 4096) (i32.const 4096)))
    (local.set $n (call $call (i32.const 4096) (local.get $n) (i32.const 8192) (i32.const 4096)))
    (local.set $draft (call $find (i32.const 8192) (local.get $n) (i32.const 256) (i32.const @DRAFT_MARKER_LEN@)))
    (if (i32.eq (local.get $draft) (i32.const -1)) (then (return (i32.const 8192) (local.get $n))))
    (local.set $p (call $find (i32.const 8192) (local.get $n) (i32.const 384) (i32.const @PROTOCOL_MARKER_LEN@)))
    (if (i32.eq (local.get $p) (i32.const -1)) (then unreachable))
    (local.set $proto (i32.load8_u (i32.add (local.get $p) (i32.const @PROTOCOL_MARKER_LEN@))))
    (if (i32.eq (local.get $proto) (i32.const 49)) (then (memory.copy (i32.const 16384) (i32.const 512) (i32.const @PREFIX_LEN@)))
      (else (if (i32.eq (local.get $proto) (i32.const 50)) (then (memory.copy (i32.const 16384) (i32.const 768) (i32.const @PREFIX_LEN@))) (else unreachable))))
    (local.set $out (call $decode (i32.add (local.get $draft) (i32.const @DRAFT_MARKER_LEN@)) (i32.add (i32.const 8192) (local.get $n)) (i32.add (i32.const 16384) (i32.const @PREFIX_LEN@)) ))
    ;; Decoder starts after the prefix; append one envelope-closing brace.
    (i32.store8 (local.get $out) (i32.const 125))
    (local.set $n (call $call (i32.const 16384) (i32.add (i32.sub (local.get $out) (i32.const 16384)) (i32.const 1)) (i32.const 24576) (i32.const 4096)))
    (i32.const 24576) (local.get $n)))
