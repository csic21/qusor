+// Owner-private caches have finite lifetimes (the process-global cache does
+// not). Last cache/lease owner destruction must debit remaining charge too.
+impl<K, V> Drop for Inner<K, V> {
+    fn drop(&mut self) {
+        let state = self.state.get_mut().unwrap_or_else(|p| p.into_inner());
+        let entries = std::mem::take(&mut state.entries);
+        for (key, entry) in entries {
+            self.budget.used.fetch_sub(entry.cost, Ordering::Relaxed);
+            if let Some(evicted) = &self.on_evict {
+                evicted(&key, &entry.value);
+            }
+            // entry/payload drops with no cache/pool mutex held.
+        }
+    }
+}
