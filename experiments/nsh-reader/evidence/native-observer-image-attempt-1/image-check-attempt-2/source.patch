+    use super::*;
+    #[test]
+    fn retirement_finite_cache_debits_budget_only_after_last_real_lease() {
+        let budget = Budget::new(1024);
+        let cache = MemoryCache::<u32, Vec<u8>>::new(&budget);
+        let lease = cache.insert(1, vec![9; 16], 16);
+        assert_eq!(budget.used(), 16);
+        drop(cache);
+        assert_eq!(budget.used(), 16, "real lease owns the cache allocation");
+        drop(lease);
