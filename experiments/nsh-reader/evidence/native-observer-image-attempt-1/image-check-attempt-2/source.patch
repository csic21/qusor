+    #[test]
+    fn retirement_cancelled_queued_decode_drops_payload_outside_pool_lock() {
+        use std::sync::Condvar;
+        let pool = loader();
+        let threads = nsh_core::image::loader::decoders();
+        let gate = Arc::new((Mutex::new(false), Condvar::new()));
+        let (started, ready) = mpsc::channel();
+        for _ in 0..threads {
+            let gate = gate.clone();
+            let started = started.clone();
+            pool.decode(Priority::Visible, move || {
+                started.send(()).unwrap();
+                let mut release = gate.0.lock().unwrap();
+                while !*release {
+                    release = gate.1.wait(release).unwrap();
+                }
+            })
+            .detach();
+        }
+        for _ in 0..threads {
+            ready.recv_timeout(Duration::from_secs(5)).unwrap();
+        }
+        let dropped = Arc::new(AtomicUsize::new(0));
+        let ran = Arc::new(AtomicUsize::new(0));
+        struct ReenterPool(Arc<AtomicUsize>);
+        impl Drop for ReenterPool {
+            fn drop(&mut self) {
+                // Would deadlock if cancelled closure destruction still held
+                // loader.decodes' mutex. No GTK/Host callback is involved.
+                loader().decode(Priority::Normal, || {}).detach();
+                self.0.store(1, Ordering::SeqCst);
+            }
