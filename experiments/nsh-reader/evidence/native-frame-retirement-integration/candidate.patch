+            s.joined.store(true, Ordering::SeqCst);
+        }
+        if s.joined.load(Ordering::SeqCst) {
+            return Ok(true);
+        }
+        if Instant::now() >= deadline {
+            return Ok(false);
+        }
+        thread::sleep(Duration::from_millis(1));
+    }
+}
