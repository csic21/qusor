@@ -0,0 +1,562 @@
+//! Experimental Linux-only native ownership observations.
+//!
+//! This vertical slice never returns a release ACK: task/decode/cache and
+//! native-child coverage are deliberately still missing. Object finalization
+//! and snapshot participation are separate facts, not physical presentation.
+use crate::{mount::Mounter, view::NshView};
+use gtk4::{glib, prelude::*};
+use nsh_core::{ImageData, MountBatch, MountItem, NodeId, ViewKind};
+use std::{
+    cell::RefCell,
+    collections::{HashMap, HashSet},
+    rc::Rc,
+};
+
+const MAX_OWNERS: usize = 8;
+const MAX_NODES: usize = 4096;
+
+/// Trusted adapter-local identity. Deliberately nonserializable and !Send.
+#[derive(Clone)]
+pub struct NativeOwner(Rc<RefCell<Facts>>);
+struct Facts {
+    root: Option<NodeId>,
+    closing: bool,
+    failure: Option<&'static str>,
+    live: HashSet<NodeId>,
+    deleted: HashSet<NodeId>,
+    finalized: HashSet<NodeId>,
+    next_stamp: u64,
+    frame: Option<ExpectedFrame>,
+    snapshot: Option<SnapshotEvidence>,
+    snapshots: u64,
+}
+struct ExpectedFrame {
+    stamp: FrameStamp,
+    data: ImageData,
+    pixels: (i32, i32),
+}
+/// Opaque, own-mount, strictly increasing frame identity.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct FrameStamp(u64);
+/// An actual image append in a GTK snapshot. This is not a display-present fence.
+#[derive(Clone, Debug, PartialEq)]
+pub struct SnapshotEvidence {
+    pub stamp: FrameStamp,
+    pub node: NodeId,
+    pub pixels: (i32, i32),
+    pub bounds_dip: (f32, f32),
+    pub scale: f32,
+    pub sequence: u64,
+}
+/// Partial evidence only. `Unprovable` must never be converted to a Host ACK.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct PartialRetirement {
+    pub root: Option<NodeId>,
+    pub closing: bool,
+    pub live_nodes: usize,
+    pub delete_applied: usize,
+    /// Qdata destroy notification reached; not a finalizer-return fence.
+    pub finalization_reached_nodes: usize,
+    pub failure: Option<&'static str>,
+    pub unprovable: &'static str,
+}
+impl NativeOwner {
+    /// Close new native/frame admission. Existing objects continue their real lifetime.
+    pub fn begin_close(&self) {
+        let mut f = self.0.borrow_mut();
+        f.closing = true;
+        f.frame = None;
+    }
+    /// Diagnostic evidence; node zero is insufficient to release a mount.
+    pub fn status(&self) -> PartialRetirement {
+        let f = self.0.borrow();
+        PartialRetirement {
+            root: f.root,
+            closing: f.closing,
+            live_nodes: f.live.len(),
+            delete_applied: f.deleted.len(),
+            finalization_reached_nodes: f.finalized.len(),
+            failure: f.failure,
+            unprovable: "native children, tasks, decode and cache not yet covered",
+        }
+    }
+    /// Bind exact ImageData identity supplied by the trusted Rust renderer, not URI/text props.
+    pub fn register_frame(
+        &self,
+        data: ImageData,
+        pixels: (i32, i32),
+    ) -> Result<FrameStamp, &'static str> {
+        let mut f = self.0.borrow_mut();
+        if f.closing || f.failure.is_some() || pixels.0 <= 0 || pixels.1 <= 0 || data.is_empty() {
+            return Err("frame admission rejected");
+        }
+        f.next_stamp = f.next_stamp.checked_add(1).ok_or("frame stamp exhausted")?;
+        let stamp = FrameStamp(f.next_stamp);
+        f.frame = Some(ExpectedFrame {
+            stamp,
+            data,
+            pixels,
+        });
+        f.snapshot = None;
+        Ok(stamp)
+    }
+    /// Last actual append observation, with bounded storage.
+    pub fn snapshot(&self) -> Option<SnapshotEvidence> {
+        self.0.borrow().snapshot.clone()
+    }
+    pub(crate) fn snapshotted(
+        &self,
+        node: NodeId,
+        data: Option<&ImageData>,
+        pixels: (i32, i32),
+        bounds: (f32, f32),
+        scale: f32,
+    ) {
+        let mut f = self.0.borrow_mut();
+        if f.closing
+            || f.failure.is_some()
+            || !f.live.contains(&node)
+            || !bounds.0.is_finite()
+            || !bounds.1.is_finite()
+            || bounds.0 <= 0.0
+            || bounds.1 <= 0.0
+            || !scale.is_finite()
+            || scale <= 0.0
+        {
+            return;
+        }
+        let Some(frame) = &f.frame else { return };
+        if data != Some(&frame.data) || pixels != frame.pixels {
+            return;
+        }
+        let stamp = frame.stamp;
+        let Some(sequence) = f.snapshots.checked_add(1) else {
+            f.failure = Some("snapshot sequence exhausted");
+            return;
+        };
+        f.snapshots = sequence;
+        f.snapshot = Some(SnapshotEvidence {
+            stamp,
+            node,
+            pixels,
+            bounds_dip: bounds,
+            scale,
+            sequence,
+        });
+    }
+    fn fail(&self, reason: &'static str) {
+        self.0.borrow_mut().failure.get_or_insert(reason);
+    }
+}
+
+/// This guard is owned by GObject qdata, not by a Rust wrapper or weak-ref.
+/// A private key is installed once and never explicitly cleared/replaced.
+/// GTK object destruction stays on its main thread. Observation is polled
+/// separately on the GTK thread; this notification only proves the qdata
+/// finalization stage was reached, not that the complete native finalizer
+/// returned. No reentrant Host callback occurs here.
+struct Finalization {
+    owner: NativeOwner,
+    node: NodeId,
+}
+impl Drop for Finalization {
+    fn drop(&mut self) {
+        let mut f = self.owner.0.borrow_mut();
+        f.live.remove(&self.node);
+        f.finalized.insert(self.node);
+    }
+}
+#[derive(Default)]
+pub(crate) struct Registry {
+    registrations: HashMap<String, NativeOwner>,
+    spent: HashSet<String>,
+    owners: Vec<NativeOwner>,
+    nodes: HashMap<NodeId, NativeOwner>,
+    installed: HashSet<NodeId>,
+}
+impl Registry {
+    pub(crate) fn register(&mut self, factory: &str) -> Result<NativeOwner, &'static str> {
+        if factory.is_empty()
+            || factory.len() > 128
+            || self.owners.len() >= MAX_OWNERS
+            || (self.registrations.contains_key(factory) || self.spent.contains(factory))
+        {
+            return Err("boundary registration rejected");
+        }
+        let owner = NativeOwner(Rc::new(RefCell::new(Facts {
+            root: None,
+            closing: false,
+            failure: None,
+            live: HashSet::new(),
+            deleted: HashSet::new(),
+            finalized: HashSet::new(),
+            next_stamp: 0,
+            frame: None,
+            snapshot: None,
+            snapshots: 0,
+        })));
+        self.registrations.insert(factory.into(), owner.clone());
+        self.owners.push(owner.clone());
+        Ok(owner)
+    }
+    /// Resolve the complete batch before any Create/source property can start work.
+    pub(crate) fn prepare(
+        &mut self,
+        batch: &MountBatch,
+        mounter: &Mounter,
+    ) -> Result<(), &'static str> {
+        match self.plan(batch, mounter) {
+            Ok((planned, roots)) => {
+                for (name, node, owner) in roots {
+                    owner.0.borrow_mut().root = Some(node);
+                    self.registrations.remove(&name);
+                    self.spent.insert(name);
+                }
+                self.nodes = planned;
+                Ok(())
+            }
+            Err(e) => {
+                for owner in &self.owners {
+                    owner.fail(e);
+                }
+                Err(e)
+            }
+        }
+    }
+    fn plan(
+        &self,
+        batch: &MountBatch,
+        mounter: &Mounter,
+    ) -> Result<
+        (
+            HashMap<NodeId, NativeOwner>,
+            Vec<(String, NodeId, NativeOwner)>,
+        ),
+        &'static str,
+    > {
+        let mut nodes = self.nodes.clone();
+        let mut roots = Vec::new();
+        let mut used = HashSet::new();
+        let mut created = HashMap::new();
+        let mut parents = HashMap::new();
+        for item in &batch.items {
+            match item {
+                MountItem::Create { id, kind } => {
+                    if created.insert(*id, *kind).is_some() || nodes.contains_key(id) {
+                        return Err("node identity reused");
+                    }
+                }
+                MountItem::Insert { parent, child, .. } => {
+                    parents.insert(*child, *parent);
+                }
+                MountItem::Component { id, name } => {
+                    if let Some(owner) = self.registrations.get(name.as_ref()) {
+                        if !used.insert(name.to_string()) || owner.0.borrow().closing {
+                            return Err("one-shot boundary reused or closed");
+                        }
+                        if nodes.insert(*id, owner.clone()).is_some() {
+                            return Err("boundary identity reused");
+                        }
+                        roots.push((name.to_string(), *id, owner.clone()));
+                    } else if self.spent.contains(name.as_ref())
+                        || self.owners.iter().any(|o| o.0.borrow().root == Some(*id))
+                    {
+                        return Err("boundary component replaced");
+                    }
+                }
+                _ => {}
+            }
+        }
+        for (_, node, _) in &roots {
+            if created.get(node) != Some(&ViewKind::Native) {
+                return Err("boundary must be a newly created native node");
+            }
+        }
+        for child in parents.keys() {
+            let mut cursor = *child;
+            let mut seen = HashSet::new();
+            while let Some(parent) = parents.get(&cursor) {
+                if !seen.insert(cursor) {
+                    return Err("native parent cycle");
+                }
+                cursor = *parent;
+            }
+        }
+        for _ in 0..=parents.len() {
+            let mut changed = false;
+            for (child, parent) in &parents {
+                if let Some(owner) = nodes.get(parent).cloned() {
+                    if let Some(old) = nodes.get(child) {
+                        if !Rc::ptr_eq(&old.0, &owner.0) {
+                            return Err("cross-owner reparent");
+                        }
+                    } else {
+                        if !created.contains_key(child) || mounter.views.contains_key(child) {
+                            return Err("retroactive owner binding");
+                        }
+                        if owner.0.borrow().closing {
+                            return Err("closed owner admission");
+                        }
+                        nodes.insert(*child, owner);
+                        changed = true;
+                    }
+                }
+            }
+            if !changed {
+                break;
+            }
+        }
+        for (child, parent) in &parents {
+            if nodes.contains_key(child)
+                && !nodes.contains_key(parent)
+                && !roots.iter().any(|(_, root, _)| root == child)
+                && !self
+                    .owners
+                    .iter()
+                    .any(|o| o.0.borrow().root == Some(*child))
+            {
+                return Err("owned node moved outside boundary");
+            }
+        }
+        if nodes.len() > MAX_NODES {
+            return Err("native node observation limit");
+        }
+        for (id, owner) in &nodes {
+            if !self.nodes.contains_key(id) {
+                if owner.0.borrow().closing
+                    || !created.contains_key(id)
+                    || mounter.views.contains_key(id)
+                {
+                    return Err("late boundary admission");
+                }
+                match created[id] {
+                    ViewKind::View
+                    | ViewKind::Text
+                    | ViewKind::Input
+                    | ViewKind::Image
+                    | ViewKind::Scroll
+                    | ViewKind::Native => {}
+                    _ => owner.fail("unsupported native resource kind"),
+                }
+            }
+        }
+        // Once closed, retain old resources only; reject state-changing operations
+        // instead of executing a late Image/source/command on an old owner.
+        for item in &batch.items {
+            match item {
+                MountItem::Delete { .. } | MountItem::Remove { .. } => {}
+                _ if mutation_node(item)
+                    .and_then(|id| nodes.get(&id))
+                    .is_some_and(|o| o.0.borrow().closing) =>
+                {
+                    return Err("closed owner mutation rejected");
+                }
+                MountItem::Animation(_) if self.owners.iter().any(|o| o.0.borrow().closing) => {
+                    return Err("global animation mutation during close unproved");
+                }
+                _ => {}
+            }
+        }
+        Ok((nodes, roots))
+    }
+    pub(crate) fn created(&mut self, view: &NshView) {
+        let Some(owner) = self.nodes.get(&view.id()).cloned() else {
+            return;
+        };
+        if !self.installed.insert(view.id()) {
+            owner.fail("duplicate finalization registration");
+            return;
+        }
+        owner.0.borrow_mut().live.insert(view.id());
+        view.state_mut().retirement_owner = Some(owner.clone());
+        // SAFETY: private key, installed once, never read/removed/replaced; the
+        // value owns no GObject reference. GObject destroys it at finalization.
+        unsafe {
+            view.set_data(
+                "qusor-retirement-finalization-913-v1",
+                Finalization {
+                    owner,
+                    node: view.id(),
+                },
+            );
+        }
+    }
+    pub(crate) fn deleted(&mut self, node: NodeId) {
+        if let Some(owner) = self.nodes.get(&node) {
+            owner.0.borrow_mut().deleted.insert(node);
+        }
+    }
+}
+
+fn mutation_node(item: &MountItem) -> Option<NodeId> {
+    match item {
+        MountItem::Create { id, .. } => Some(*id),
+        MountItem::TrackStates { id, .. } => Some(*id),
+        MountItem::ProjectStates { id, .. } => Some(*id),
+        MountItem::Remove { id, .. } => Some(*id),
+        MountItem::Delete { id, .. } => Some(*id),
+        MountItem::Frame { id, .. } => Some(*id),
+        MountItem::Overflow { id, .. } => Some(*id),
+        MountItem::ViewStyle { id, .. } => Some(*id),
+        MountItem::Text { id, .. } => Some(*id),
+        MountItem::Events { id, .. } => Some(*id),
+        MountItem::Image { id, .. } => Some(*id),
+        MountItem::ScrollConfig { id, .. } => Some(*id),
+        MountItem::ScrollContent { id, .. } => Some(*id),
+        MountItem::ScrollBy { id, .. } => Some(*id),
+        MountItem::StickyCells { id, .. } => Some(*id),
+        MountItem::ScrollBehavior { id, .. } => Some(*id),
+        MountItem::Refreshing { id, .. } => Some(*id),
+        MountItem::Canvas { id, .. } => Some(*id),
+        MountItem::Shader { id, .. } => Some(*id),
+        MountItem::ShaderTransition { id, .. } => Some(*id),
+        MountItem::NavShader { id, .. } => Some(*id),
+        MountItem::ShaderInput { id, .. } => Some(*id),
+        MountItem::AnimationBindings { id, .. } => Some(*id),
+        MountItem::Gestures { id, .. } => Some(*id),
+        MountItem::ViewProps { id, .. } => Some(*id),
+        MountItem::AccessibilityLabel { id, .. } => Some(*id),
+        MountItem::Input { id, .. } => Some(*id),
+        MountItem::InputValue { id, .. } => Some(*id),
+        MountItem::InputContent { id, .. } => Some(*id),
+        MountItem::ScreenConfig { id, .. } => Some(*id),
+        MountItem::NativeProps { id, .. } => Some(*id),
+        MountItem::ModalConfig { id, .. } => Some(*id),
+        MountItem::Component { id, .. } => Some(*id),
+        MountItem::ComponentPropSlots { id, .. } => Some(*id),
+        MountItem::ComponentProps { id, .. } => Some(*id),
+        MountItem::Command { id, .. } => Some(*id),
+        MountItem::Insert { child, .. } => Some(*child),
+        _ => None,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::gtk_test;
+    fn create_boundary(surface: &Rc<crate::surface::Surface>, kind: ViewKind) -> NativeOwner {
+        let owner = surface
+            .retirement
+            .borrow_mut()
+            .register("fixture/one-shot")
+            .unwrap();
+        surface.apply(&MountBatch {
+            items: vec![
+                MountItem::Create {
+                    id: 2,
+                    kind: ViewKind::Native,
+                },
+                MountItem::Create { id: 3, kind },
+                // Deliberately children before boundary and parent: ownership is
+                // planned over the full batch, not assigned after Insert.
+                MountItem::Insert {
+                    parent: 2,
+                    child: 3,
+                    before: None,
+                },
+                MountItem::Component {
+                    id: 2,
+                    name: "fixture/one-shot".into(),
+                },
+                MountItem::Insert {
+                    parent: nsh_core::ROOT_ID,
+                    child: 2,
+                    before: None,
+                },
+            ],
+        });
+        assert_eq!(owner.status().root, Some(2));
+        assert_eq!(owner.status().live_nodes, 2);
+        owner
+    }
+    #[test]
+    fn retirement_real_finalization_waits_for_clone_and_survives_dispose() {
+        gtk_test::run(|| {
+            let s=gtk_test::surface(); let o=create_boundary(&s,ViewKind::View);
+            let held=gtk_test::view(&s,3); let clone=held.clone();
+            o.begin_close();
+            s.apply(&MountBatch{items:vec![MountItem::Delete{id:2},MountItem::Delete{id:3}]});
+            assert_eq!(o.status().delete_applied,2);
+            assert_eq!(o.status().live_nodes,1,"real GTK clone must hold native object");
+            // SAFETY: dedicated detached fixture on GTK's main thread; we keep
+            // strong refs intentionally to distinguish dispose from finalize.
+            unsafe { held.run_dispose(); }
+            assert_eq!(o.status().live_nodes,1,"run_dispose must not fake finalization");
+            drop(held); assert_eq!(o.status().live_nodes,1);
+            drop(clone); assert_eq!(o.status().live_nodes,0);
+            assert_eq!(o.status().finalization_reached_nodes,2);
+            assert!(!o.status().unprovable.is_empty(),"nodes alone never ACK");
+            eprintln!("OBSERVER_REAL_FINALIZATION clones_blocked=true dispose_not_ack=true qdata_finalization_reached=2 finalizer_return_claimed=false unprovable=true");
+        }).expect("real GTK display required for this qualification test");
+    }
