                      ],
                      "properties": {
                        "kind": {
                          "const": "commit_replace"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "kind"
                      ],
                      "properties": {
                        "kind": {
                          "const": "cancel_replace"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "complete": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expected_checkpoint_revision"
              ],
              "properties": {
                "kind": {
                  "const": "cancel_event"
                },
                "expected_checkpoint_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                }
              }
            }
          ]
        }
