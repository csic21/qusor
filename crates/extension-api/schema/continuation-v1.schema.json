{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUSOR own-event continuation protocol1",
  "description": "API0.3 only; request<=65536 encoded bytes, response<=4096. Rust enforces decoded checkpoint<=8192 and chunk<=2048, canonical padded base64 including pad bits, cross-field bounds. Validation neither authorizes nor applies atomic effects. request_id only correlates replies and is not an effect identity.",
  "oneOf": [
    {
      "type": "object",
