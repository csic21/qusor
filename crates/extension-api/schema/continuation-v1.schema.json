              "const": 0
            },
            "minor": {
              "const": 3
            }
          }
        },
        "continuation_protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
