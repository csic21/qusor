              "maxLength": 128
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "minLength": 32,
              "maxLength": 32
            }
          }
        },
        "mount_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
