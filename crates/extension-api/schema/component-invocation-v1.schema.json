{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUSOR component invocation bootstrap protocol1",
  "description": "API0.3 only. Request <=65536 encoded bytes; response <=4096. Purpose only: no identity, text, permission or user approval. Legacy invocation/context protocols are unchanged.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "component_invocation_protocol",
        "operation"
      ],
      "properties": {
        "api_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "const": 0
            },
            "minor": {
              "const": 3
            }
          }
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 32
        },
        "component_invocation_protocol": {
          "const": 1
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "read_context"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "request_id",
        "component_invocation_protocol",
        "context"
      ],
      "properties": {
        "api_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "const": 0
            },
            "minor": {
              "const": 3
            }
          }
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 32
        },
        "component_invocation_protocol": {
          "const": 1
        },
        "context": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "edit_event"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "paragraph_projection"
                }
              }
            }
          ]
        }
      }
    }
  ]
}
