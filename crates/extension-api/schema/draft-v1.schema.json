{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QUSOR draft editing protocol1",
  "description": "Explicit opt-in API0.3. Rust additionally enforces UTF-8/encoded byte budgets and cross-field relations. Schema validation grants no permission.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "draft_protocol",
        "request_id",
        "resource",
        "mount_id",
        "operation"
      ],
      "properties": {
        "api_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "const": 0
            },
            "minor": {
              "const": 3
            }
          }
        },
        "draft_protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 32
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "vault_id",
            "draft_id"
          ],
          "properties": {
            "kind": {
              "const": "draft"
            },
            "vault_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "minLength": 1,
              "maxLength": 128
            },
            "draft_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$",
              "minLength": 32,
              "maxLength": 32
            }
          }
        },
        "mount_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "operation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "revision",
                "offset",
                "max_bytes"
              ],
              "properties": {
                "kind": {
                  "const": "read_chunk"
                },
                "revision": {
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 18446744073709551615
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "max_bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "expected_revision",
                "total_bytes"
              ],
              "properties": {
                "kind": {
                  "const": "begin_replace"
                },
                "expected_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                },
                "total_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id",
                "offset",
                "text"
              ],
              "properties": {
                "kind": {
                  "const": "append_chunk"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "text": {
                  "type": "string",
                  "maxLength": 512,
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id"
              ],
              "properties": {
                "kind": {
                  "const": "commit_replace"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id"
              ],
              "properties": {
                "kind": {
                  "const": "cancel_replace"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                }
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "draft_protocol",
        "request_id",
        "draft_id",
        "mount_id",
        "outcome"
      ],
      "properties": {
        "api_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "major",
            "minor"
          ],
          "properties": {
            "major": {
              "const": 0
            },
            "minor": {
              "const": 3
            }
          }
        },
        "draft_protocol": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "minLength": 1,
          "maxLength": 32
        },
        "draft_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "mount_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "minLength": 32,
          "maxLength": 32
        },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "revision",
                "offset",
                "total_bytes",
                "text"
              ],
              "properties": {
                "kind": {
                  "const": "snapshot"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "total_bytes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                },
                "text": {
                  "type": "string",
                  "maxLength": 512
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id"
              ],
              "properties": {
                "kind": {
                  "const": "upload_started"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id",
                "next_offset"
              ],
              "properties": {
                "kind": {
                  "const": "chunk_accepted"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                },
                "next_offset": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1048576
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "revision"
              ],
              "properties": {
                "kind": {
                  "const": "replaced"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 18446744073709551615
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "upload_id"
              ],
              "properties": {
                "kind": {
                  "const": "cancelled"
                },
                "upload_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$",
                  "minLength": 32,
                  "maxLength": 32
                }
              }
            }
          ]
        }
      }
    }
  ]
}
